#pragma once

// ==========================================
// Operational Mode
// ==========================================
#define MODE_NORMAL         0   // Full Always-On Server Starter (Default)
#define MODE_TEST_AT        1   // Test 1: Shield AT Communication & Power Check
#define MODE_TEST_WIFI      2   // Test 2: Wi-Fi Association Check
#define MODE_TEST_WOL       3   // Test 3: Standalone WOL Magic Packet Test (bypasses CF)
#define MODE_TEST_CF        4   // Test 4: Cloudflare HTTPS/SSL Ping Test

// Choose which mode to run:
#define RUN_MODE            MODE_NORMAL

// ==========================================
// Network & Credentials
// ==========================================
// Wi-Fi Configuration (2.4 GHz only)
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"
#define DEVICE_HOSTNAME     "serverstarter"  // Accessible at http://serverstarter.local (Mac/Linux/iOS/Win10+) or http://serverstarter (Windows NetBIOS/DHCP)

// Cloudflare Worker Configuration (Hostname ONLY, no "https://")
#define CF_HOST             "YOUR_WORKER_SUBDOMAIN.workers.dev"

// AOD Device Secret Token (matches AOD_DEVICE_KEY in Cloudflare Worker)
#define AUTH_TOKEN          "CHANGE_ME_AOD_DEVICE_KEY"

// Target Server Configuration
#define SERVER_MAC          "00:11:22:33:44:55"
#define SERVER_IP           "192.168.1.100"
#define SERVER_PORT         22

// Timing Configuration (milliseconds)
#define SERVER_CHECK_INTERVAL_MS 5000   // Probe LAN server every 5 seconds
#define CF_SYNC_INTERVAL_MS      30000  // Sync with Cloudflare every 30 seconds
